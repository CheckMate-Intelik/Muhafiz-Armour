    "@react-navigation/native": "^7.1.6",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "^55.0.0",
    "expo-router": "~6.0.10",
