generator client {
  provider = "prisma-client-js"
}

// Pooled Neon URL should include `pgbouncer=true` (see prisma.service.ts). Use DIRECT_URL for CLI migrate if you add it.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  REQUESTED
  PENDING_DRIVER
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  BLOCKED
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  phone            String    @unique
  email            String?   @unique
  passwordHash     String?
  profileImageUrl  String?
  isBlocked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  bookings         Booking[]
}

model Driver {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  phone            String   @unique
  email            String?  @unique
  passwordHash     String?
  profileImageUrl  String?
  isApproved       Boolean  @default(false)
  isBlocked        Boolean  @default(false)
  createdAt        DateTime @default(now())

  vehicles  Vehicle[]
  bookings  Booking[]
}

model Booking {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverId        String?          @db.Uuid
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId       String?          @db.Uuid
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  pickupLocation  String
  dropLocation    String
  pickupCity      String?
  dropCity        String?
  pickupLat       Float?
  pickupLng       Float?
  dropLat         Float?
  dropLng         Float?
  bufferMinutes   Int?
  startTime       DateTime
  endTime         DateTime
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status          BookingStatus    @default(REQUESTED)
  totalPrice      Int?
  overtimeMinutes Int?
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  driverId        String      @db.Uuid
  driver          Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  armourLevel     String   @db.Text
  vehicleType     String   @db.Text
  carModel        String?
  manufacturer    String?
  generation      String?
  year            Int?
  color           String?
  numberPlate     String?
  registrationNumber String?
  imageUrls       String[]    @default([])
  baseRatePerHour Int
  location        String
  status          VehicleStatus @default(AVAILABLE)
  seatingCapacity Int           @default(4)
  isApproved      Boolean     @default(false)
  createdAt       DateTime    @default(now())

  bookings Booking[]

  @@index([driverId])
}

model ArmourLevelOption {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model VehicleTypeOption {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

