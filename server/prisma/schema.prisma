generator client {
  provider = "prisma-client-js"
}

// Pooled Neon URL should include `pgbouncer=true` (see prisma.service.ts). Use DIRECT_URL for CLI migrate if you add it.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  REQUESTED
  PENDING_DISPATCHER
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  BLOCKED
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  SIGNUP_SUCCESS
  SIGNUP_FAILURE
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_SUCCESS
  PASSWORD_RESET_FAILURE
}

enum AdminActionType {
  APPROVE_DISPATCHER
  BLOCK_DISPATCHER
  BLOCK_USER
  APPROVE_VEHICLE
  UPDATE_VEHICLE
  CREATE_CATALOG_OPTION
  UPDATE_CATALOG_OPTION
  DELETE_CATALOG_OPTION
  FORCE_CANCEL_BOOKING
  REASSIGN_BOOKING
  EXTEND_DISPATCHER_DEADLINE
  SET_BOOKING_REVIEW
}

enum BookingAuditAction {
  CREATED
  SCHEDULE_UPDATED
  VEHICLE_SELECTED
  STATUS_CHANGED
  EXTENSION_REQUESTED
  EXTENSION_APPROVED
  EXTENSION_REJECTED
  EXTENSION_CANCELLED
  EXPIRED
  DISPATCHER_REJECTED
  DISPATCHER_CANCELLED
  CANCELLED
  ADMIN_FORCE_CANCELLED
  ADMIN_REASSIGNED
  ADMIN_EXTENDED_DEADLINE
  ADMIN_MARKED_REVIEW
  ADMIN_UNMARKED_REVIEW
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String
  displayName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminAuditLogs AdminAuditLog[]
}

model AuthAuditLog {
  id        String        @id @default(uuid()) @db.Uuid
  eventType AuthEventType
  role      String?
  email     String?
  username  String?
  ipAddress String?
  userAgent String?
  message   String?
  createdAt DateTime      @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model AdminAuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  adminId    String          @db.Uuid
  admin      Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  actionType AdminActionType
  targetType String?
  targetId   String?         @db.Uuid
  details    Json?
  ipAddress  String?
  createdAt  DateTime        @default(now())

  @@index([adminId])
  @@index([actionType])
  @@index([createdAt])
}

model BookingAuditLog {
  id           String             @id @default(uuid()) @db.Uuid
  bookingId    String             @db.Uuid
  actorRole    String
  actorId      String?            @db.Uuid
  action       BookingAuditAction
  fromStatus   BookingStatus?
  toStatus     BookingStatus?
  details      Json?
  createdAt    DateTime           @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model PasswordResetCode {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  role      String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, role])
  @@index([expiresAt])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  phone            String    @unique
  email            String?   @unique
  passwordHash     String?
  profileImageUrl  String?
  isBlocked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  bookings         Booking[]
  pushDeviceTokens PushDeviceToken[]
}

model Dispatcher {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  phone            String   @unique
  email            String?  @unique
  passwordHash     String?
  profileImageUrl  String?
  isApproved       Boolean  @default(false)
  isBlocked        Boolean  @default(false)
  createdAt        DateTime @default(now())

  vehicles         Vehicle[]
  bookings         Booking[]
  pushDeviceTokens PushDeviceToken[]
}

model PushDeviceToken {
  id            String   @id @default(uuid()) @db.Uuid
  expoPushToken String   @unique
  platform      String
  userId        String?  @db.Uuid
  dispatcherId  String?  @db.Uuid
  updatedAt     DateTime @updatedAt
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  dispatcher    Dispatcher?  @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dispatcherId])
}

model Booking {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatcherId    String?          @db.Uuid
  dispatcher      Dispatcher?      @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)
  vehicleId       String?          @db.Uuid
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  pickupLocation  String
  dropLocation    String
  pickupCity      String?
  dropCity        String?
  pickupLat       Float?
  pickupLng       Float?
  dropLat         Float?
  dropLng         Float?
  bufferMinutes   Int?
  startTime       DateTime
  endTime         DateTime
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status               BookingStatus    @default(REQUESTED)
  pendingDispatcherAt  DateTime?
  totalPrice           Int?
  overtimeMinutes      Int?
  isUnderReview        Boolean          @default(false)
  adminReviewNote      String?
  createdAt            DateTime         @default(now())

  extensionRequests BookingExtensionRequest[]

  @@index([userId])
  @@index([status])
  @@index([dispatcherId])
  @@index([vehicleId])
}

model BookingExtensionRequest {
  id                 String                 @id @default(uuid()) @db.Uuid
  bookingId          String                 @db.Uuid
  booking            Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  additionalHours    Int
  previousEndTime    DateTime
  requestedEndTime   DateTime
  proposedTotalPrice Int
  status             ExtensionRequestStatus @default(PENDING)
  createdAt          DateTime               @default(now())
  resolvedAt         DateTime?

  @@index([bookingId])
  @@index([status])
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  dispatcherId    String      @db.Uuid
  dispatcher      Dispatcher  @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)
  armourLevel     String   @db.Text
  vehicleType     String   @db.Text
  carModel        String?
  manufacturer    String?
  generation      String?
  year            Int?
  color           String?
  numberPlate     String?
  registrationNumber String?
  imageUrls       String[]    @default([])
  baseRatePerHour      Int
  extensionRatePerHour Int
  location             String
  status          VehicleStatus @default(AVAILABLE)
  seatingCapacity Int           @default(4)
  isApproved      Boolean     @default(false)
  createdAt       DateTime    @default(now())

  bookings Booking[]

  @@index([dispatcherId])
}

model ArmourLevelOption {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model VehicleTypeOption {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
